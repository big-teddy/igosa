# Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# ===========================================
# Supabase Configuration (REQUIRED)
# ===========================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# OpenAI Configuration (REQUIRED)
# ===========================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Payment Gateway (OPTIONAL - for payment features)
# ===========================================
# Choose one PG provider and configure accordingly:

# Option 1: Toss Payments
# Get keys from: https://developers.tosspayments.com/my/api-keys
# TOSS_CLIENT_KEY=test_ck_your-client-key
# TOSS_SECRET_KEY=test_sk_your-secret-key

# Option 2: Portone (구 아임포트)
# Get keys from: https://admin.portone.io/
# PORTONE_API_KEY=your-portone-api-key
# PORTONE_API_SECRET=your-portone-api-secret

# ===========================================
# Sentry (OPTIONAL - for error tracking)
# ===========================================
# Get DSN from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ===========================================
# Upstash Redis (OPTIONAL - for rate limiting)
# ===========================================
# Get credentials from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# Application Settings
# ===========================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production
