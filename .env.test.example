# Test Environment Variables
# Copy this to .env.test and fill in your test credentials

# Supabase Test Project (권장: 별도 테스트 프로젝트 사용)
NEXT_PUBLIC_SUPABASE_URL="https://your-test-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-test-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-test-service-role-key"

# Test App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis (선택 - 없으면 Mock 사용)
REDIS_URL="redis://localhost:6379"
# 또는
UPSTASH_REDIS_REST_URL="https://your-test-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-test-token"

# AI APIs (통합 테스트용 - 선택)
OPENAI_API_KEY="sk-test-..."

# Test Configuration
SUPPRESS_LOGS="true"  # 테스트 중 로그 숨기기
