# Feature Flags (네고딜 통합 관련)
NEXT_PUBLIC_ENABLE_UNIFIED_NEGODEAL="true"     # 통합 네고딜 위젯
NEXT_PUBLIC_ENABLE_NEGODEAL_V2_PAGE="true"     # 새 네고딜 페이지
NEXT_PUBLIC_ENABLE_NEW_NAVIGATION="true"       # 업데이트된 헤더 메뉴
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS="true"   # AI 추천 가격

# A/B Testing & Gradual Rollout
NEXT_PUBLIC_ROLLOUT_PERCENT="100"              # 롤아웃 비율 (0-100)
                                               # Week 2: 10, Week 3: 30, Week 4: 50, Week 5: 100
